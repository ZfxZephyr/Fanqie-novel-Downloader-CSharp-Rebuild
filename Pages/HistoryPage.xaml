<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FanqieNovelDownloader.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FanqieNovelDownloader.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FanqieNovelDownloader.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="下载历史" />

            <TextBlock
                x:Name="RecordCountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="共 0 条记录" />
        </Grid>

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <AppBarButton
                Click="DeleteSelectedButton_Click"
                Label="删除选中文档">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="ClearAllButton_Click"
                Label="清空记录">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- 空状态 -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Glyph="&#xE81C;" />
            <TextBlock
                Margin="0,16,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="暂无下载历史" />
        </StackPanel>

        <!-- 历史记录列表 -->
        <ListView
            x:Name="HistoryListView"
            Grid.Row="2"
            IsItemClickEnabled="True"
            IsMultiSelectCheckBoxEnabled="True"
            ItemClick="HistoryListView_ItemClick"
            SelectionMode="Multiple"
            Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <Grid Padding="16,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 记录信息 -->
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Author}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Format}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind FileSizeDisplay}" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind DownloadTimeDisplay}" />
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="OpenFileLocationButton_Click"
                                Tag="{x:Bind RecordId}">
                                <FontIcon Glyph="&#xE8B7;" />
                            </Button>
                            <Button
                                Click="RemoveRecordButton_Click"
                                Tag="{x:Bind RecordId}">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
