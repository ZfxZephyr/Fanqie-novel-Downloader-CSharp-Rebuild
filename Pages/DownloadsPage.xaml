<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FanqieNovelDownloader.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FanqieNovelDownloader.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FanqieNovelDownloader.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="下载任务" />

            <TextBlock
                x:Name="TaskCountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="共 0 个任务" />
        </Grid>

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <AppBarButton
                Click="StartAllButton_Click"
                Label="全部开始">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="PauseAllButton_Click"
                Label="全部暂停">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE71A;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton
                Click="ClearCompletedButton_Click"
                Label="清空已完成">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton
                Click="RetryFailedButton_Click"
                Label="重试失败">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- 空状态 -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Glyph="&#xE896;" />
            <TextBlock
                Margin="0,16,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="暂无下载任务" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="在书籍详情页点击下载全本开始下载" />
        </StackPanel>

        <!-- 下载任务列表 -->
        <ListView
            x:Name="TaskListView"
            Grid.Row="2"
            Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadTask">
                    <Grid Padding="16,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 封面 -->
                        <Border
                            Width="60"
                            Height="80"
                            CornerRadius="4">
                            <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                        </Border>

                        <!-- 任务信息 -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Author}" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ProgressText}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind FormatText}" />
                            </StackPanel>
                            <ProgressBar
                                Maximum="100"
                                Value="{x:Bind Progress}" />
                            <TextBlock
                                x:Name="StatusTextBlock"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText}" />
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="PauseResumeButton_Click"
                                Tag="{x:Bind TaskId}">
                                <FontIcon Glyph="&#xE769;" />
                            </Button>
                            <Button
                                Click="ResumeButton_Click"
                                Tag="{x:Bind TaskId}">
                                <FontIcon Glyph="&#xE768;" />
                            </Button>
                            <Button
                                Click="RetryButton_Click"
                                Tag="{x:Bind TaskId}">
                                <FontIcon Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                Click="CancelButton_Click"
                                Tag="{x:Bind TaskId}">
                                <FontIcon Glyph="&#xE711;" />
                            </Button>
                            <Button
                                Click="RemoveButton_Click"
                                Tag="{x:Bind TaskId}">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
