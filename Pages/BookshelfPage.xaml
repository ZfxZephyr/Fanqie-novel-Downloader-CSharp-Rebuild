<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FanqieNovelDownloader.Pages.BookshelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FanqieNovelDownloader.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FanqieNovelDownloader.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="我的书架" />

            <TextBlock
                x:Name="BookCountText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="共 0 本" />
        </Grid>

        <!-- 空状态 -->
        <StackPanel
            x:Name="EmptyStatePanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Visible">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Glyph="&#xE8F1;" />
            <TextBlock
                Margin="0,16,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="书架为空" />
            <TextBlock
                Margin="0,8,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="搜索小说后点击加入书架" />
        </StackPanel>

        <!-- 书籍列表 -->
        <ListView
            x:Name="BookListView"
            Grid.Row="1"
            IsItemClickEnabled="True"
            ItemClick="BookListView_ItemClick"
            SelectionMode="None"
            Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BookshelfItem">
                    <Grid Padding="16,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 封面 -->
                        <Border
                            Width="60"
                            Height="80"
                            CornerRadius="4">
                            <Image Source="{x:Bind CoverImage}" Stretch="UniformToFill" />
                        </Border>

                        <!-- 书籍信息 -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Author}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind LastReadDisplay}" />
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="ContinueReadingButton_Click"
                                Tag="{x:Bind BookId}">
                                <FontIcon Glyph="&#xE8A9;" />
                            </Button>
                            <Button
                                Click="RemoveButton_Click"
                                Tag="{x:Bind BookId}">
                                <FontIcon Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
