<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FanqieNovelDownloader.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FanqieNovelDownloader.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FanqieNovelDownloader.Models"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="搜索小说" />

        <AutoSuggestBox
            Grid.Row="1"
            PlaceholderText="输入关键词、番茄小说链接或书籍ID"
            QueryIcon="Find"
            QuerySubmitted="SearchBox_QuerySubmitted"
            TextChanged="SearchBox_TextChanged" />

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="ResultCountText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="搜索结果" />

            <!-- 加载状态 -->
            <ProgressRing
                x:Name="LoadingRing"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />

            <!-- 空状态提示 -->
            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="输入关键词开始搜索"
                Visibility="Visible" />

            <!-- 错误提示 -->
            <TextBlock
                x:Name="ErrorText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!-- 搜索结果列表 -->
            <GridView
                x:Name="SearchResultsGrid"
                Grid.Row="1"
                IsItemClickEnabled="True"
                ItemClick="SearchResultsGrid_ItemClick"
                SelectionMode="None"
                Visibility="Collapsed">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:BookInfo">
                        <Grid
                            Width="220"
                            Height="380"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="160" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 书名 -->
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- 封面图片 -->
                            <Border
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                CornerRadius="4">
                                <Image
                                    Source="{x:Bind CoverImage}"
                                    Stretch="UniformToFill" />
                            </Border>

                            <!-- 作者 -->
                            <TextBlock
                                Grid.Row="2"
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Author}" />

                            <!-- 简介 -->
                            <TextBlock
                                Grid.Row="3"
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="{x:Bind Description}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- 字数和章节数 -->
                            <StackPanel
                                Grid.Row="4"
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind WordCountDisplay}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ChapterCountDisplay}" />
                            </StackPanel>

                            <!-- 在读人数 -->
                            <TextBlock
                                Grid.Row="5"
                                Margin="0,4,0,0"
                                FontSize="10"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind ReadCountDisplay}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
