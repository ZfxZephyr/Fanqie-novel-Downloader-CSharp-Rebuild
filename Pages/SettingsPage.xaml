<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FanqieNovelDownloader.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FanqieNovelDownloader.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,16">
        <StackPanel Spacing="24">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />

            <!-- 下载设置 -->
            <Expander Header="下载设置" IsExpanded="True">
                <StackPanel Spacing="12">
                    <TextBlock Text="默认保存目录" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="SavePathTextBox"
                            MinWidth="300"
                            IsReadOnly="True"
                            Text="C:\Users\Downloads\FanqieNovels" />
                        <Button Content="浏览..." />
                    </StackPanel>

                    <TextBlock Text="默认导出格式" />
                    <ComboBox x:Name="ExportFormatComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="TXT" />
                        <ComboBoxItem Content="EPUB" />
                    </ComboBox>
                </StackPanel>
            </Expander>

            <!-- 阅读设置 -->
            <Expander Header="阅读设置">
                <StackPanel Spacing="12">
                    <TextBlock Text="字体大小" />
                    <Slider
                        x:Name="FontSizeSlider"
                        Maximum="32"
                        Minimum="12"
                        Value="16" />

                    <TextBlock Text="阅读主题" />
                    <ComboBox x:Name="ThemeComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                        <ComboBoxItem Content="跟随系统" />
                    </ComboBox>

                    <ToggleSwitch Header="沉浸阅读模式" />
                </StackPanel>
            </Expander>

            <!-- 网络设置 -->
            <Expander Header="网络设置">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="使用代理" />
                    <TextBlock Text="代理地址" />
                    <TextBox PlaceholderText="http://127.0.0.1:7890" />

                    <TextBlock Text="请求超时（秒）" />
                    <NumberBox Value="30" />
                </StackPanel>
            </Expander>

            <!-- 高级设置 -->
            <Expander Header="高级设置">
                <StackPanel Spacing="12">
                    <ToggleSwitch Header="开启诊断日志" />
                    <ToggleSwitch Header="自动检查更新" IsOn="True" />
                    <Button Content="清除临时缓存" />
                    <Button Content="删除离线正文" />
                </StackPanel>
            </Expander>

            <!-- 关于 -->
            <Expander Header="关于">
                <StackPanel Spacing="8">
                    <TextBlock Text="番茄小说阅读器 v1.0.0" />
                    <TextBlock Text="基于 WinUI 3 重构版" />
                    <HyperlinkButton Content="GitHub 仓库" NavigateUri="https://github.com/POf-L/Fanqie-novel-Downloader" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
