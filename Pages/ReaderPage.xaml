<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FanqieNovelDownloader.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FanqieNovelDownloader.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- 加载状态 -->
        <ProgressRing
            x:Name="LoadingRing"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />

        <!-- 内容区域 -->
        <Grid x:Name="ContentGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 -->
            <Grid
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Click="BackButton_Click"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>

                <TextBlock
                    x:Name="ChapterTitleText"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="ChapterListButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE8A9;" />
                    </Button>
                    <Button
                        Click="SettingsButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 阅读内容 -->
            <Grid Grid.Row="1">
                <ScrollViewer
                    x:Name="ContentScrollViewer"
                    Padding="32,24">
                    <RichTextBlock
                        x:Name="ContentRichTextBlock"
                        FontSize="18"
                        LineHeight="36"
                        FontFamily="Segoe UI"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- 章节切换加载遮罩 -->
                <Grid
                    x:Name="ChapterLoadingOverlay"
                    Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <ProgressRing
                            HorizontalAlignment="Center"
                            IsActive="True"
                            Width="40"
                            Height="40" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="正在加载章节内容..." />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 底部导航栏 -->
            <Grid
                x:Name="BottomNavBar"
                Grid.Row="2"
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PrevChapterButton"
                    Click="PrevChapterButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" />
                        <TextBlock Text="上一章" />
                    </StackPanel>
                </Button>

                <TextBlock
                    x:Name="ChapterProgressText"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button
                    x:Name="NextChapterButton"
                    Grid.Column="2"
                    Click="NextChapterButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="下一章" />
                        <FontIcon Glyph="&#xE72A;" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 章节列表面板 -->
        <Grid
            x:Name="ChapterListPanel"
            HorizontalAlignment="Right"
            Visibility="Collapsed"
            Width="320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="章节目录" />
                <Button
                    x:Name="SortButton"
                    Grid.Column="1"
                    Click="SortButton_Click"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="切换排序">
                    <FontIcon Glyph="&#xE8CB;" />
                </Button>
                <Button
                    Grid.Column="2"
                    Click="CloseChapterListButton_Click"
                    Style="{ThemeResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE711;" />
                </Button>
            </Grid>

            <ListView
                x:Name="ChapterList"
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                IsItemClickEnabled="True"
                ItemClick="ChapterList_ItemClick"
                SelectionMode="None" />
        </Grid>

        <!-- 阅读设置面板 -->
        <Grid
            x:Name="SettingsPanel"
            HorizontalAlignment="Right"
            Padding="16"
            Visibility="Collapsed"
            Width="320"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                <Grid>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="阅读设置" />
                    <Button
                        HorizontalAlignment="Right"
                        Click="CloseSettingsButton_Click"
                        Style="{ThemeResource SubtleButtonStyle}">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!-- 字体选择 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="字体" />
                    <ComboBox
                        x:Name="FontComboBox"
                        SelectedIndex="0"
                        SelectionChanged="FontComboBox_SelectionChanged">
                        <ComboBoxItem Content="系统默认" />
                        <ComboBoxItem Content="微软雅黑" />
                        <ComboBoxItem Content="宋体" />
                        <ComboBoxItem Content="楷体" />
                    </ComboBox>
                </StackPanel>

                <!-- 字体大小 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="字体大小" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="FontSizeSlider"
                            Maximum="32"
                            Minimum="12"
                            ValueChanged="FontSizeSlider_ValueChanged"
                            Value="18" />
                        <TextBlock
                            x:Name="FontSizeText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="18" />
                    </Grid>
                </StackPanel>

                <!-- 行间距 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="行间距" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="LineHeightSlider"
                            Maximum="60"
                            Minimum="24"
                            ValueChanged="LineHeightSlider_ValueChanged"
                            Value="36" />
                        <TextBlock
                            x:Name="LineHeightText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="36" />
                    </Grid>
                </StackPanel>

                <!-- 阅读主题 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="阅读主题" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="ThemeSystemButton"
                            Click="ThemePresetButton_Click"
                            Tag="System"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                            <StackPanel Spacing="2" Margin="8,6">
                                <Border
                                    Width="64"
                                    Height="24"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="Aa" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Text="跟随系统" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeLightButton"
                            Grid.Column="1"
                            Click="ThemePresetButton_Click"
                            Tag="Light"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                            <StackPanel Spacing="2" Margin="8,6">
                                <Border
                                    Width="64"
                                    Height="24"
                                    Background="#FFFFFF"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#1A1A1A"
                                        Text="Aa" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Text="亮色" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeDarkButton"
                            Grid.Column="2"
                            Click="ThemePresetButton_Click"
                            Tag="Dark"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                            <StackPanel Spacing="2" Margin="8,6">
                                <Border
                                    Width="64"
                                    Height="24"
                                    Background="#1E1E1E"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#DCDCDC"
                                        Text="Aa" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Text="暗色" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeSepiaButton"
                            Grid.Row="1"
                            Click="ThemePresetButton_Click"
                            Tag="Sepia"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                            <StackPanel Spacing="2" Margin="8,6">
                                <Border
                                    Width="64"
                                    Height="24"
                                    Background="#F5F0E8"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#50432C"
                                        Text="Aa" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Text="米黄" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeGreenButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Click="ThemePresetButton_Click"
                            Tag="Green"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                            <StackPanel Spacing="2" Margin="8,6">
                                <Border
                                    Width="64"
                                    Height="24"
                                    Background="#C7EDCC"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#2B3A2B"
                                        Text="Aa" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Text="绿色" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeCustomButton"
                            Grid.Row="1"
                            Grid.Column="2"
                            Click="ThemePresetButton_Click"
                            Tag="Custom"
                            HorizontalAlignment="Stretch"
                            Padding="0">
                            <StackPanel Spacing="2" Margin="8,6">
                                <Border
                                    x:Name="ThemeCustomSwatchBorder"
                                    Width="64"
                                    Height="24"
                                    Background="#F5F0E8"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        x:Name="ThemeCustomSwatchText"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#50432C"
                                        Text="Aa" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="10"
                                    Text="自定义" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 自定义颜色（选"自定义"时展开） -->
                    <StackPanel x:Name="CustomThemePanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="背景颜色" />
                        <ColorPicker
                            x:Name="BgColorPicker"
                            ColorChanged="BgColorPicker_ColorChanged"
                            IsAlphaEnabled="False"
                            IsAlphaSliderVisible="False"
                            IsAlphaTextInputVisible="False"
                            IsColorChannelTextInputVisible="False"
                            IsColorPreviewVisible="False"
                            IsMoreButtonVisible="False" />
                        <TextBlock Text="文字颜色" />
                        <ColorPicker
                            x:Name="FgColorPicker"
                            ColorChanged="FgColorPicker_ColorChanged"
                            IsAlphaEnabled="False"
                            IsAlphaSliderVisible="False"
                            IsAlphaTextInputVisible="False"
                            IsColorChannelTextInputVisible="False"
                            IsColorPreviewVisible="False"
                            IsMoreButtonVisible="False" />
                    </StackPanel>
                </StackPanel>

                <!-- 分隔线 -->
                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!-- 隐蔽模式 -->
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="隐蔽模式" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="StealthModeToggle"
                            HorizontalAlignment="Right"
                            Toggled="StealthModeToggle_Toggled"
                            OnContent="开"
                            OffContent="关" />
                    </Grid>
                    <StackPanel x:Name="StealthSettingsPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="显示行数" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="StealthLineSlider"
                                Maximum="10"
                                Minimum="1"
                                ValueChanged="StealthLineSlider_ValueChanged"
                                Value="3" />
                            <TextBlock
                                x:Name="StealthLineText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="3" />
                        </Grid>
                        <TextBlock Text="滚动步长" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="StealthStepSlider"
                                Maximum="10"
                                Minimum="1"
                                ValueChanged="StealthStepSlider_ValueChanged"
                                Value="1" />
                            <TextBlock
                                x:Name="StealthStepText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="1" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
