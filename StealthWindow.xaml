<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FanqieNovelDownloader.StealthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="记事本"
    mc:Ignorable="d">

    <!-- 半透明亚克力背景 -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 内容区：显示设置的 N 行 -->
        <Grid Grid.Row="0" Padding="12,10,12,6">
            <ScrollViewer
                VerticalAlignment="Top"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="LinesHost" Spacing="4" />
            </ScrollViewer>

            <!-- 加载指示 -->
            <StackPanel
                x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="Collapsed">
                <ProgressRing
                    Width="24"
                    Height="24"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="正在加载..." />
            </StackPanel>
        </Grid>

        <!-- 底部按钮栏 -->
        <Grid
            x:Name="BottomBar"
            Grid.Row="1"
            Padding="8,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="UpLinesButton"
                Click="UpLinesButton_Click"
                FontSize="12"
                Padding="10,4" />
            <Button
                x:Name="PrevChapterButton"
                Grid.Column="1"
                Click="PrevChapterButton_Click"
                FontSize="12"
                Padding="10,4"
                Content="上一章" />
            <TextBlock
                x:Name="ProgressText"
                Grid.Column="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="NextChapterButton"
                Grid.Column="3"
                Click="NextChapterButton_Click"
                FontSize="12"
                Padding="10,4"
                Content="下一章" />
            <Button
                x:Name="DownLinesButton"
                Grid.Column="4"
                Click="DownLinesButton_Click"
                FontSize="12"
                Padding="10,4" />
        </Grid>
    </Grid>
</Window>
